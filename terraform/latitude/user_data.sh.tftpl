#cloud-config
package_update: true
packages:
  - git
  - curl
  - jq

write_files:
  - path: /etc/filo512.env
    permissions: '0600'
    content: |
      WORK_DIR="/opt/filo512"
      PROVIDER="latitude"
      DRY_RUN="${dry_run}"
      PUSH_RESULTS="true"
      AUTO_DESTROY="${auto_destroy}"
      GITHUB_USER="${github_user}"
      GITHUB_REPO="${github_repo}"
      GITHUB_TOKEN="${github_token}"
      LATITUDE_API_KEY="${latitude_api_key}"
      PROJECT_ID="${project_id}"

runcmd:
  - git clone "https://github.com/${github_user}/${github_repo}.git" /opt/filo512
  - /opt/filo512/scripts/install_standalone.sh
