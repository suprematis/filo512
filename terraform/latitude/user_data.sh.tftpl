#!/usr/bin/env bash
set -euxo pipefail

exec > >(tee -a /var/log/filo512-autorun.log) 2>&1

# 1. Write secrets & config to an isolated root-only env file
cat << 'ENV_EOF' > /etc/filo512.env
GITHUB_USER="${github_user}"
GITHUB_REPO="${github_repo}"
GITHUB_TOKEN="${github_token}"
LATITUDE_API_KEY="${latitude_api_key}"
PROJECT_ID="${project_id}"
AUTO_DESTROY="${auto_destroy}"
DRY_RUN="${dry_run}"
ENV_EOF
chmod 600 /etc/filo512.env
source /etc/filo512.env

AUTH_REPO_URL="https://$${GITHUB_USER}:$${GITHUB_TOKEN}@github.com/$${GITHUB_USER}/$${GITHUB_REPO}.git"
WORK_DIR="/opt/filo512"

# 2. Clone repo on initial boot
if [ ! -d "$WORK_DIR" ]; then
    git clone "$AUTH_REPO_URL" "$WORK_DIR"
    cd "$WORK_DIR"
    git config user.name "Filo512 Automated Runner"
    git config user.email "bot@filo512.local"
fi

# 3. Install systemd oneshot service to survive the GRUB clearcpuid reboot
cat << 'SERVICE_EOF' > /etc/systemd/system/filo512-runner.service
[Unit]
Description=Filo512 Automated Two-Pass AVX-512 Benchmark State Machine
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/filo512
ExecStart=/opt/filo512/scripts/auto_pipeline.sh
StandardOutput=append:/var/log/filo512-autorun.log
StandardError=append:/var/log/filo512-autorun.log

[Install]
WantedBy=multi-user.target
SERVICE_EOF

# 4. Create the static two-pass state machine script
cat << 'PIPE_EOF' > /opt/filo512/scripts/auto_pipeline.sh
#!/usr/bin/env bash
set -euxo pipefail
source /etc/filo512.env
cd /opt/filo512

if [ ! -f /opt/filo512/.pass1_complete ]; then
    echo ">>> [PASS 1] Running Native AVX-512 Suite (DRY_RUN=$${DRY_RUN})..." DRY_RUN="$${DRY_RUN}" ./scripts/run_all.sh avx512_on
    touch /opt/filo512/.pass1_complete

    echo ">>> [PASS 1 COMPLETE] Masking AVX-512 in GRUB and rebooting..."
    ./scripts/01_toggle_kernel_avx512.sh disable
    systemctl reboot

elif [ ! -f /opt/filo512/.pass2_complete ]; then
    echo ">>> [PASS 2] Running AVX-512 Masked Suite (DRY_RUN=$${DRY_RUN})..." DRY_RUN="$${DRY_RUN}" ./scripts/run_all.sh avx512_off
    touch /opt/filo512/.pass2_complete

    # Restore GRUB and disable systemd service
    ./scripts/01_toggle_kernel_avx512.sh enable
    systemctl disable filo512-runner.service

    # Commit and push results to a hardware-timestamped branch
    CPU_SLUG=$$(grep -m1 'model name' /proc/cpuinfo \vert{} awk -F': ' '{print$$2}' | tr ' ' '_' | tr -cd '[:alnum:]_-')
    RUN_BRANCH="results/$${CPU_SLUG}-$$(date -u +%Y%m%d-%H%M%S)"

    git checkout -b "$$RUN_BRANCH" cp /var/log/filo512-autorun.log ./results/autorun.log \vert{}\vert{} true git add results/ git commit -m "chore(results): automated AVX-512 vs AVX2 run on $${CPU_SLUG}"
    git push -u origin "$$RUN_BRANCH"      echo ">>> [GIT PUSH COMPLETE] Pushed branch: $$RUN_BRANCH"

    # Self-destruct via Latitude API
    if [ "$$AUTO_DESTROY" = "true" ] && [ -n "$$LATITUDE_API_KEY" ]; then
        echo ">>> [AUTO-DESTROY] Locating Server ID on Latitude.sh..."
        PRIMARY_IP=$$(hostname -I \vert{} awk '{print$$1}')
        SERVER_ID=$$(curl -s -g \ -H "Authorization: Bearer $${LATITUDE_API_KEY}" \
            -H "Accept: application/vnd.api+json" \
            "https://api.latitude.sh/servers?filter[project]=$${PROJECT_ID}" \vert{} \ jq -r ".data[] \vert{} select(.attributes.primary_ipv4 == \"$$PRIMARY_IP\") | .id")

        if [ -n "$$SERVER_ID" ] && [ "$$SERVER_ID" != "null" ]; then
            echo ">>> [AUTO-DESTROY] Terminating Server ID: $$SERVER_ID" curl -s -X DELETE \ -H "Authorization: Bearer $${LATITUDE_API_KEY}" \
                -H "Accept: application/vnd.api+json" \
                "https://api.latitude.sh/servers/$${SERVER_ID}" else echo ">>> [WARN] Could not match Server ID for IP $$PRIMARY_IP. Destroy manually via Terraform!"
        fi
    fi
fi
PIPE_EOF
chmod +x /opt/filo512/scripts/auto_pipeline.sh

systemctl daemon-reload
systemctl enable --now filo512-runner.service
